// Windows resources for JumpStart4.exe (configured by CMake).
#include <winver.h>

@JS4_ICON_LINE@

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "@APP_NAME@"
      VALUE "ProductName", "@APP_NAME@: Haunted Island"
      VALUE "FileVersion", "@APP_VERSION@"
      VALUE "ProductVersion", "@APP_VERSION@"
      VALUE "OriginalFilename", "JumpStart4.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
